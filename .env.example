# ==============================================================================
# FinSight-AI Environment Configuration Example
# Copy this file to .env and configure with your local values.
# NEVER commit real credentials or API keys to version control.
# ==============================================================================

# Application Settings
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=your-super-secret-key-change-this-in-production
APP_HOST=0.0.0.0
APP_PORT=8000

# Database Configuration (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=finsight_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/finsight_db

# Frontend Settings
FRONTEND_URL=http://localhost:3000
VITE_API_BASE_URL=http://localhost:8000

# AI / LLM Integrations (Placeholders only)
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here

# Financial / Market Data API Keys (Placeholders only)
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-api-key-here
FINNHUB_API_KEY=your-finnhub-api-key-here
